---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { getT } from '../i18n/index';
import HomeStory from '../components/HomeStory.astro';
import HomeFacts from '../components/HomeFacts.astro';
import HomeValues from '../components/HomeValues.astro';
import EmailCapture from '../components/EmailCapture.astro';

const lang = 'en';
const t = getT(lang);
const h = t.home;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "HappyBein",
      "url": SITE.url,
      "logo": `${SITE.url}/images/logo.png`,
      "foundingDate": SITE.founded,
      "description": SITE.description,
      "address": { "@type": "PostalAddress", "addressLocality": "Eindhoven", "addressCountry": "NL" },
      "contactPoint": { "@type": "ContactPoint", "email": SITE.email },
      "sameAs": Object.values(SITE.social),
    },
    { "@type": "WebSite", "url": SITE.url, "name": SITE.name },
  ]
});
---
<Base
  title={h.title}
  description={h.description}
  canonical="https://happybein.com/"
  lang={lang}
  alternateEn="https://happybein.com/"
  alternateFr="https://happybein.com/fr/"
  schema={schema}
>
  <section class="hero max-w-6xl mx-auto px-5 grid gap-14 items-center"
           style="min-height:88vh; padding-top:4.5rem; padding-bottom:4rem; grid-template-columns:1fr 1.15fr;">
    <div>
      <h1 class="font-display font-black text-ink leading-[1.12] tracking-tight mb-5"
          style="font-size:clamp(1.55rem, 2.8vw, 2.6rem); max-width:520px;">
        Structured understanding unlocks solutions.
      </h1>
      <p class="leading-relaxed mb-8 max-w-[480px]" style="color:#2C4A4A; font-size:1.05rem; line-height:1.75;">
        Get clarity on complex topics, with free guides, plain-language explainers and everyday tools.
        <span class="block mt-3 font-semibold" style="color:#1A9A9A; font-size:0.95rem;">Because life is complicated enough — navigating it shouldn't be.</span>
      </p>
      <div class="flex gap-3">
        <a href="#what-we-help-with" class="btn-primary hero-btn hero-btn-main">{h.btnExplore}</a>
        <a href="#who-we-are" class="btn-outline hero-btn hero-btn-alt">{h.btnManifesto}</a>
      </div>
    </div>
    <img src="/images/hero-path.svg" alt="Understand people, understand society, act on it" width="560" height="440" class="hero-art w-full h-auto" />
  </section>

  <HomeStory lang={lang} />

  <HomeFacts lang={lang} />

  <HomeValues lang={lang} />

  <EmailCapture />

  <section class="py-20 px-5 text-center" style="background:#E8F7F7;">
    <div class="teal-gradient rounded-2xl p-16 max-w-2xl mx-auto text-white" style="box-shadow:0 12px 40px rgba(42,191,191,0.2);">
      <h2 class="font-display font-extrabold leading-tight mb-4" style="font-size:clamp(1.4rem,2.5vw,2.1rem);">{h.ctaTitle}</h2>
      <p class="opacity-90 mb-8 leading-relaxed">{h.ctaDesc}</p>
      <a href={lang === 'fr' ? '/fr/contact' : '/contact'} class="btn-white">{h.ctaBtn}</a>
    </div>
  </section>
</Base>

<style>
  /* Hero buttons: normal capitalisation, both in brand teal, side by side and equal on phones */
  .hero-btn { text-transform: none; letter-spacing: 0; font-size: 0.95rem; justify-content: center; white-space: nowrap; }
  .hero-btn-main { background: #1A9A9A; border-color: #1A9A9A; }
  .hero-btn-main:hover, .hero-btn-main:active { background: #157F7F; border-color: #157F7F; }
  .hero-btn-alt { background: #E8F7F7; }
  @media (max-width: 640px) {
    .hero-btn { flex: 1 1 0; padding-left: 0.75rem; padding-right: 0.75rem; }
  }
  /* Phones: halve the space between sections (desktop sizes looked empty) */
  @media (max-width: 640px) {
    section:first-of-type { padding-top: 2rem !important; padding-bottom: 1.5rem !important; }
    :global(main > section.py-20) { padding-top: 3rem; padding-bottom: 3rem; }
    :global(main > section.py-16), :global(main > section.py-14) { padding-top: 2.5rem; padding-bottom: 2.5rem; }
  }
  @media (max-width: 960px) {
    section:first-of-type { grid-template-columns: 1fr !important; min-height: auto !important; }
    .hero-art { display: none; }
    .max-w-6xl > .grid { grid-template-columns: 1fr !important; }
  }
</style>
