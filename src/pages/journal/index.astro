---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

const entries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

// A plain-text preview pulled from the article body itself (not the optional
// description field) — strips markdown syntax down to readable text, visual
// truncation to two lines is handled by the `line-clamp-2` class below.
const excerpt = (md: string, maxLen = 220): string => {
  const plain = md
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`~]/g, '')
    .replace(/\n+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > maxLen ? plain.slice(0, maxLen).trim() + '…' : plain;
};

// Separates day-to-day build notes from the more reflective/strategic
// entries about HappyBein itself — same two values enforced by the content
// schema (src/content/config.ts) and offered in the Decap CMS field.
const CATEGORY_META: Record<string, { label: string; badgeClass: string }> = {
  'dev-update': { label: 'Development Update', badgeClass: 'bg-teal-DEFAULT/10 text-teal-dark' },
  'history-strategy': { label: 'History & Strategy', badgeClass: 'bg-[#29ABE2]/10 text-[#1A7FAA]' },
};
const FILTERS: { key: string; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'dev-update', label: 'Development Updates' },
  { key: 'history-strategy', label: 'History & Strategy' },
];
---
<Base
  title="Journal – HappyBein"
  description="Notes, reflections and updates from the HappyBein journal."
  canonical="https://happybein.com/journal"
  lang={lang}
>
  <div class="journal-hero px-5" style="background:#E8F7F7; border-bottom:1px solid rgba(42,191,191,0.18);">
    <div class="max-w-6xl mx-auto">
      <div class="section-label">Notes &amp; Reflections</div>
      <h1 class="font-display font-black text-ink tracking-tight leading-[1.1] mb-2"
          style="font-size:clamp(1.6rem,3vw,2.4rem);">Journal</h1>
      <p class="text-muted leading-relaxed">Thoughts, updates and reflections along the way.</p>
    </div>
  </div>

  <section class="py-12 px-5">
    <div class="max-w-5xl mx-auto">
      {entries.length === 0 && (
        <p class="text-muted">No entries yet — check back soon.</p>
      )}
      {entries.length > 0 && (
        <div class="journal-filters" role="group" aria-label="Filter journal by category">
          {FILTERS.map((f) => (
            <button
              type="button"
              class="journal-filter-btn"
              data-filter={f.key}
              aria-pressed={f.key === 'all' ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))}
        </div>
      )}
      <p id="journalEmptyMsg" class="text-muted" style="display:none;">No entries in this category yet.</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="journalGrid">
        {entries.map((entry) => (
          <li class="journal-card" data-category={entry.data.category}>
            <a href={`/journal/${entry.slug}`} class="group flex flex-col h-full p-6">
              <span class={`inline-flex items-center text-2xs font-bold tracking-widest uppercase px-2.5 py-1 rounded-full self-start mb-2 ${CATEGORY_META[entry.data.category].badgeClass}`}>
                {CATEGORY_META[entry.data.category].label}
              </span>
              <div class="font-mono-sm text-muted mb-2">{dateFmt(entry.data.date)}</div>
              <h2 class="font-display font-extrabold text-ink text-lg leading-snug group-hover:text-teal-dark transition-colors mb-2">
                {entry.data.title}
              </h2>
              <p class="text-body leading-relaxed text-sm line-clamp-2 mb-2">{excerpt(entry.body)}</p>
              <span class="inline-block mt-auto text-sm font-bold text-teal-dark">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .journal-hero {
    padding-top: 1.8rem;
    padding-bottom: 1.8rem;
  }
  .journal-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }
  .journal-filter-btn {
    font-family: 'Nunito', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid rgba(42,191,191,0.3);
    background: white;
    color: #2C4A4A;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .journal-filter-btn:hover {
    border-color: #2ABFBF;
  }
  .journal-filter-btn[aria-pressed="true"] {
    background: #1A9A9A;
    border-color: #1A9A9A;
    color: white;
  }
  .journal-card {
    background: white;
    border-radius: 0.75rem;
    border: 1px solid rgba(42,191,191,0.18);
    box-shadow: 0 2px 14px rgba(26,153,154,0.12);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
    overflow: hidden;
    min-height: 170px;
  }
  .journal-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(26,153,154,0.18);
  }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.journal-filter-btn');
  const cards = document.querySelectorAll<HTMLLIElement>('#journalGrid .journal-card');
  const emptyMsg = document.getElementById('journalEmptyMsg');

  function applyFilter(filter: string) {
    let visibleCount = 0;
    cards.forEach((card) => {
      const match = filter === 'all' || card.dataset.category === filter;
      card.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      applyFilter(btn.dataset.filter || 'all');
    });
  });
</script>
