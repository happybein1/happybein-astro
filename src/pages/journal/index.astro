---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

const entries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title="Journal – HappyBein"
  description="Notes, reflections and updates from the HappyBein journal."
  canonical="https://happybein.com/journal"
  lang={lang}
>
  <div class="journal-hero px-5" style="background:#E8F7F7; border-bottom:1px solid rgba(42,191,191,0.18);">
    <div class="max-w-6xl mx-auto">
      <div class="section-label">Notes &amp; Reflections</div>
      <h1 class="font-display font-black text-ink tracking-tight leading-[1.1] mb-2"
          style="font-size:clamp(1.6rem,3vw,2.4rem);">Journal</h1>
      <p class="text-muted leading-relaxed">Thoughts, updates and reflections along the way.</p>
    </div>
  </div>

  <section class="py-12 px-5">
    <div class="max-w-[760px] mx-auto">
      {entries.length === 0 && (
        <p class="text-muted">No entries yet — check back soon.</p>
      )}
      <ul class="flex flex-col gap-5">
        {entries.map((entry) => (
          <li class="journal-card">
            <a href={`/journal/${entry.slug}`} class="group block p-6">
              <div class="font-mono-sm text-muted mb-2">{dateFmt(entry.data.date)}</div>
              <h2 class="font-display font-extrabold text-ink text-xl group-hover:text-teal-dark transition-colors mb-2">
                {entry.data.title}
              </h2>
              {entry.data.description && (
                <p class="text-body leading-relaxed mb-2">{entry.data.description}</p>
              )}
              <span class="inline-block text-sm font-bold text-teal-dark">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .journal-hero {
    padding-top: 1.8rem;
    padding-bottom: 1.8rem;
  }
  .journal-card {
    background: white;
    border-radius: 0.75rem;
    border: 1px solid rgba(42,191,191,0.18);
    box-shadow: 0 2px 14px rgba(26,153,154,0.12);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }
  .journal-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(26,153,154,0.18);
  }
</style>
